<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_phone_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_phone_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuanLyDanhBa">

        <!-- LoginActivity: Màn hình khởi chạy đầu tiên -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity: Danh sách liên hệ -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false" />

        <!-- AddContactActivity: Thêm liên hệ -->
        <activity
            android:name=".activity.AddContactActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ContactDetailActivity: Chi tiết liên hệ -->
        <activity
            android:name=".activity.ContactDetailActivity"
            android:exported="false" />

    </application>

</manifest>
